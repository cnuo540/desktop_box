<UserControl x:Class="DesktopBox.Controls.BoxControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:DesktopBox.Controls"
             xmlns:m="clr-namespace:DesktopBox.Models"
             AllowDrop="True"
             Drop="OnDrop"
             DragOver="OnDragOver"
             LostMouseCapture="OnLostMouseCapture"
             MouseEnter="OnBoxMouseEnter"
             MouseLeave="OnBoxMouseLeave">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
        <ctl:EnumEqualityToBoolConverter x:Key="ModeEqual"/>
    </UserControl.Resources>
    <Border x:Name="Card"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            CornerRadius="10"
            Background="#99000000"
            ClipToBounds="True">
        <!-- 边框走 Style:拖动中的盒子悬停在本盒子上(IsMergeTarget)时要高亮成"合并目标" -->
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="BorderBrush" Value="#66FFFFFF"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsMergeTarget}" Value="True">
                        <Setter Property="BorderBrush" Value="#FF4FC3F7"/>
                        <Setter Property="BorderThickness" Value="2"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 标题栏:鼠标按下可拖动整个盒子;双击=卷起/展开 -->
            <Border Grid.Row="0"
                    x:Name="HeaderBar"
                    Background="#66000000"
                    Padding="12,8"
                    MouseLeftButtonDown="OnHeaderDown"
                    MouseMove="OnHeaderMove"
                    MouseLeftButtonUp="OnHeaderUp">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>   <!-- 0 时间(平时显示,鼠标进盒子时隐藏) -->
                        <ColumnDefinition Width="*"/>      <!-- 1 名称(居中) -->
                        <ColumnDefinition Width="Auto"/>   <!-- 2 色标 + 操作按钮 -->
                    </Grid.ColumnDefinitions>

                    <!-- 标题栏时钟:默认关闭(在盒子右键菜单「显示时间」里按盒子开启),避免所有盒子都显示时间。
                         开启后鼠标移到盒子上时淡出(用 Opacity 而不是 Visibility:保留占位,悬停时名称不跳动)。 -->
                    <TextBlock Grid.Column="0"
                               x:Name="HeaderClock"
                               Text="{Binding Source={x:Static ctl:HeaderClock.Instance}, Path=CurrentTime}"
                               Visibility="{Binding ShowClock, Converter={StaticResource BoolVis}}"
                               Margin="0,0,10,0"
                               FontSize="16"
                               Foreground="#B3FFFFFF"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Opacity" Value="1"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                        <Setter Property="Opacity" Value="0"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Grid.Column="1"
                               x:Name="HeaderTitle"
                               Text="{Binding Header}"
                               FontWeight="SemiBold"
                               FontSize="13"
                               Foreground="White"
                               VerticalAlignment="Center"
                               TextAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>

                    <!-- 右侧:三个操作按钮(锁 / 卷起 / 眼睛)。
                         按钮平时隐藏,鼠标移到盒子上(展开区域)才显示——平时标题栏只留时间与名称。
                         隐藏用 Hidden 保留占位,名称的位置不会因悬停而跳动。 -->
                    <StackPanel Grid.Column="2"
                                x:Name="HeaderActions"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="4,0,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Hidden"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <!-- 锁定位置:锁定后不能拖动/缩放(蓝色闭合锁=已锁定,灰色开口锁=未锁定)。
                             锁定的盒子仍可卷起/悬停展开——它们不改变盒子位置。 -->
                        <Button x:Name="LockBtn"
                                Click="OnToggleLock"
                                ToolTip="{Binding LockActionText}"
                                Width="24" Height="24" Padding="0"
                                Background="Transparent"
                                BorderBrush="#66FFFFFF"
                                Cursor="Hand">
                            <Path Width="16" Height="16" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Data" Value="M9,9 V6.5 A2.5,2.5 0 0 1 14,6.5 M5,9 H14 V17 H5 Z"/>
                                        <Setter Property="Stroke" Value="#FF777777"/>
                                        <Setter Property="StrokeThickness" Value="1.4"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                                <Setter Property="Data" Value="M7,9 V6.5 A2.5,2.5 0 0 1 12,6.5 V9 M5,9 H14 V17 H5 Z"/>
                                                <Setter Property="Stroke" Value="#FF4FC3F7"/>
                                                <Setter Property="StrokeThickness" Value="1.8"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Button>
                        <!-- 图标大小:大图标 → 中图标 → 列表 循环(全局生效,所有盒子一致)。
                             图标本身反映当前档位:1 个大方块 / 4 个中方块 / 3 条横杠(列表)。
                             小图标 / 详细信息 / 平铺仍从盒子右键菜单「查看」里选。 -->
                        <Button x:Name="IconSizeBtn"
                                Click="OnCycleIconSize"
                                ToolTip="{Binding IconSizeActionText}"
                                Width="24" Height="24" Margin="4,0,0,0" Padding="0"
                                Background="Transparent"
                                BorderBrush="#66FFFFFF"
                                Cursor="Hand">
                            <Path Width="15" Height="15" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Fill="#FFDDDDDD">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Data" Value="M2,2 H14 V14 H2 Z"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ViewMode}" Value="{x:Static m:ViewMode.Medium}">
                                                <Setter Property="Data" Value="M1,1 H7 V7 H1 Z M9,1 H15 V7 H9 Z M1,9 H7 V15 H1 Z M9,9 H15 V15 H9 Z"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ViewMode}" Value="{x:Static m:ViewMode.List}">
                                                <Setter Property="Data" Value="M1,3 H15 V5 H1 Z M1,8 H15 V10 H1 Z M1,13 H15 V15 H1 Z"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Button>
                        <!-- 卷起/展开按钮:展开时显示向上箭头(点了就卷起),卷起时显示向下箭头。
                             卷起后鼠标悬停会自动展开(可在设置里关掉)。 -->
                        <Button x:Name="CollapseBtn"
                                Click="OnToggleCollapse"
                                ToolTip="{Binding CollapseActionText}"
                                Width="24" Height="24" Margin="4,0,0,0" Padding="0"
                                Background="Transparent"
                                BorderBrush="#66FFFFFF"
                                Cursor="Hand">
                            <Path Width="12" Height="7" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Stroke="White" StrokeThickness="1.8">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Data" Value="M1,7 L6,1 L11,7"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCollapsed}" Value="True">
                                                <Setter Property="Data" Value="M1,1 L6,7 L11,1"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Button>
                        <!-- 设置按钮:点击打开与盒子右键完全相同的菜单 -->
                        <Button x:Name="SettingsBtn"
                                Click="OnOpenContextMenu"
                                ToolTip="{DynamicResource menu.settings}"
                                Width="24" Height="24" Margin="4,0,0,0" Padding="0"
                                Background="Transparent"
                                BorderBrush="#66FFFFFF"
                                Cursor="Hand">
                            <Path Width="16" Height="16" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  StrokeThickness="1.55"
                                  Stroke="#F2FFFFFF"
                                  Fill="Transparent"
                                  StrokeLineJoin="Round"
                                  Data="M12,2.5 L13.1,5.05 C13.55,5.18 13.98,5.36 14.38,5.59 L16.95,4.55 L19.45,7.05 L18.41,9.62 C18.64,10.02 18.82,10.45 18.95,10.9 L21.5,12 L18.95,13.1 C18.82,13.55 18.64,13.98 18.41,14.38 L19.45,16.95 L16.95,19.45 L14.38,18.41 C13.98,18.64 13.55,18.82 13.1,18.95 L12,21.5 L10.9,18.95 C10.45,18.82 10.02,18.64 9.62,18.41 L7.05,19.45 L4.55,16.95 L5.59,14.38 C5.36,13.98 5.18,13.55 5.05,13.1 L2.5,12 L5.05,10.9 C5.18,10.45 5.36,10.02 5.59,9.62 L4.55,7.05 L7.05,4.55 L9.62,5.59 C10.02,5.36 10.45,5.18 10.9,5.05 Z M12,9 A3,3 0 1,0 12,15 A3,3 0 1,0 12,9 Z"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 标签行(仅标签模式且非卷起时可见) -->
            <Grid Grid.Row="1"
                  x:Name="TabRow"
                  Visibility="{Binding ShowTabs, Converter={StaticResource BoolVis}}"
                  Background="#33000000">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>     <!-- 左弹性:把标签组顶到中间 -->
                    <ColumnDefinition Width="Auto"/>  <!-- 标签组(合并盒子的多个名字) -->
                    <ColumnDefinition Width="*"/>     <!-- 右弹性 -->
                </Grid.ColumnDefinitions>
                <!-- 标签组居中:两侧各一个弹性列。MaxWidth 兜底——标签多到超过盒子宽度时
                     仍由 ListBox 内部横向滚动(滚轮可换标签),不会顶穿盒子。 -->
                <ListBox x:Name="TabList" Grid.Column="1"
                         MaxWidth="{Binding ActualWidth, ElementName=TabRow}"
                         Margin="0,0,34,0"
                         ItemsSource="{Binding Tabs}"
                         SelectedItem="{Binding SelectedTab, Mode=TwoWay}"
                         Background="Transparent"
                         BorderThickness="0"
                         Focusable="False"
                         AllowDrop="True"
                         PreviewMouseLeftButtonDown="OnTabListMouseDown"
                         PreviewMouseMove="OnTabListMouseMove"
                         PreviewMouseRightButtonDown="OnTabListPreviewMouseRightButtonDown"
                         PreviewMouseWheel="OnTabListPreviewMouseWheel"
                         DragOver="OnTabListDragOver"
                         Drop="OnTabListDrop"
                         ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="10,4"/>
                            <Setter Property="Margin" Value="2,3"/>
                            <Setter Property="Foreground" Value="#FFCCCCCC"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <!-- 鼠标移到标签名上即切换(等价于点一下),不必先点再等 -->
                            <EventSetter Event="MouseEnter" Handler="OnTabItemMouseEnter"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Grid>
                                            <!-- 选中背景 (Selected) -->
                                            <Border x:Name="SelectedBd"
                                                    CornerRadius="6"
                                                    Background="#665599FF"
                                                    BorderBrush="#995599FF"
                                                    BorderThickness="1"
                                                    Opacity="0"
                                                    IsHitTestVisible="False"/>
                                            <!-- 悬停背景 (Hover) -->
                                            <Border x:Name="HoverBd"
                                                    CornerRadius="6"
                                                    Background="#26FFFFFF"
                                                    BorderBrush="#33FFFFFF"
                                                    BorderThickness="1"
                                                    Opacity="0"
                                                    IsHitTestVisible="False"/>
                                            <!-- 内容呈现 -->
                                            <Border x:Name="ContentBd"
                                                    CornerRadius="6"
                                                    Padding="{TemplateBinding Padding}"
                                                    Background="Transparent">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="HoverBd" Property="Opacity" Value="1"/>
                                                <Trigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="HoverBd"
                                                                             Storyboard.TargetProperty="Opacity"
                                                                             To="1.0" Duration="0:0:0.15"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.EnterActions>
                                                <Trigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="HoverBd"
                                                                             Storyboard.TargetProperty="Opacity"
                                                                             To="0.0" Duration="0:0:0.15"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.ExitActions>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="SelectedBd" Property="Opacity" Value="1"/>
                                                <Setter Property="Foreground" Value="White"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Trigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="SelectedBd"
                                                                             Storyboard.TargetProperty="Opacity"
                                                                             To="1.0" Duration="0:0:0.15"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.EnterActions>
                                                <Trigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="SelectedBd"
                                                                             Storyboard.TargetProperty="Opacity"
                                                                             To="0.0" Duration="0:0:0.15"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.ExitActions>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Header}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Button Grid.Column="2" Content="+"
                        HorizontalAlignment="Right"
                        Width="24" Height="22" Margin="2,3,8,3"
                        FontSize="16" Padding="0"
                        Click="OnAddTab" ToolTip="{DynamicResource tip.newTab}"/>
            </Grid>

            <!-- 条目列表(当前标签 / Items):按 ViewMode 切换布局。卷起时整块隐藏,只留标题栏 -->
            <ScrollViewer x:Name="ItemsScroll"
                          Grid.Row="2"
                          Visibility="{Binding ShowContent, Converter={StaticResource BoolVis}}"
                          VerticalScrollBarVisibility="Visible"
                          HorizontalScrollBarVisibility="Disabled"
                          Background="Transparent"
                          PreviewMouseLeftButtonDown="OnItemsAreaMouseDown"
                          Padding="4">
                <Grid x:Name="ItemsViewport"
                      Width="{Binding ElementName=ItemsScroll, Path=ViewportWidth}"
                      Background="Transparent">
                    <!-- 大图标:默认(大方块) -->
                    <ItemsControl ItemsSource="{Binding DisplayItems}"
                                  Visibility="{Binding IsLarge, Converter={StaticResource BoolVis}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel ItemWidth="100" Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate><ctl:ItemTile IconSize="Large"/></DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 中等图标 -->
                    <ItemsControl ItemsSource="{Binding DisplayItems}"
                                  Visibility="{Binding IsMedium, Converter={StaticResource BoolVis}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel ItemWidth="84" Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate><ctl:ItemTile IconSize="Medium"/></DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 小图标(横向流式,16px 图标 + 名称) -->
                    <ItemsControl ItemsSource="{Binding DisplayItems}"
                                  Visibility="{Binding IsSmall, Converter={StaticResource BoolVis}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate><ctl:ItemTile IconSize="Small"/></DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 列表(纵向单列) -->
                    <ItemsControl ItemsSource="{Binding DisplayItems}"
                                  Visibility="{Binding IsList, Converter={StaticResource BoolVis}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Vertical"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate><ctl:ItemTile IconSize="Small"/></DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 详细信息:名称/修改时间/大小 -->
                    <ItemsControl ItemsSource="{Binding DisplayItems}"
                                  Visibility="{Binding IsDetail, Converter={StaticResource BoolVis}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Vertical"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate><ctl:ItemTile IconSize="Detail"/></DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 平铺(图标+名称,横向卡片) -->
                    <ItemsControl ItemsSource="{Binding DisplayItems}"
                                  Visibility="{Binding IsTile, Converter={StaticResource BoolVis}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate><ctl:ItemTile IconSize="Tile"/></DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </ScrollViewer>

            <!-- 八方向缩放手柄:覆盖卡片边缘。中间透明区域 hit-test 穿透到下层,不影响交互。
                 卷起时(没有内容区可缩放)或锁定位置时不显示。 -->
            <Grid Grid.Row="0" Grid.RowSpan="3" Margin="0"
                  Visibility="{Binding ShowResizeHandles, Converter={StaticResource BoolVis}}">
                <Grid.Resources>
                    <Style TargetType="Thumb">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Thumb">
                                    <Rectangle Fill="Transparent"/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Grid.Resources>
                <Border HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Width="18"
                        Height="18"
                        Margin="0,0,5,5"
                        IsHitTestVisible="False"
                        Opacity="0.55">
                    <Canvas>
                        <Line X1="14" Y1="4" X2="4" Y2="14" Stroke="#CCFFFFFF" StrokeThickness="1"/>
                        <Line X1="14" Y1="9" X2="9" Y2="14" Stroke="#CCFFFFFF" StrokeThickness="1"/>
                    </Canvas>
                </Border>
                <Thumb Tag="N"  HorizontalAlignment="Stretch" VerticalAlignment="Top"    Height="10" Margin="0,0,44,0" Cursor="SizeNS"   IsHitTestVisible="True" DragStarted="OnResizeStarted" DragDelta="OnResize" DragCompleted="OnResizeCompleted"/>
                <Thumb Tag="S"  HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Height="18" Margin="12,0,12,4" Cursor="SizeNS"   IsHitTestVisible="True" DragStarted="OnResizeStarted" DragDelta="OnResize" DragCompleted="OnResizeCompleted"/>
                <Thumb Tag="W"  VerticalAlignment="Stretch"   HorizontalAlignment="Left"  Width="10" Cursor="SizeWE"   IsHitTestVisible="True" DragStarted="OnResizeStarted" DragDelta="OnResize" DragCompleted="OnResizeCompleted"/>
                <Thumb Tag="E"  VerticalAlignment="Stretch"   HorizontalAlignment="Right" Width="18" Margin="0,36,4,12" Cursor="SizeWE"   IsHitTestVisible="True" DragStarted="OnResizeStarted" DragDelta="OnResize" DragCompleted="OnResizeCompleted"/>
                <Thumb Tag="NW" HorizontalAlignment="Left"  VerticalAlignment="Top"    Width="24" Height="24" Cursor="SizeNWSE" IsHitTestVisible="True" DragStarted="OnResizeStarted" DragDelta="OnResize" DragCompleted="OnResizeCompleted"/>
                <Thumb Tag="SW" HorizontalAlignment="Left"  VerticalAlignment="Bottom" Width="24" Height="24" Cursor="SizeNESW" IsHitTestVisible="True" DragStarted="OnResizeStarted" DragDelta="OnResize" DragCompleted="OnResizeCompleted"/>
                <Thumb Tag="NE" HorizontalAlignment="Right" VerticalAlignment="Top"    Width="12" Height="28" Margin="0,4,0,0" Cursor="SizeNESW" IsHitTestVisible="True" DragStarted="OnResizeStarted" DragDelta="OnResize" DragCompleted="OnResizeCompleted"/>
                <Thumb Tag="SE" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="28" Height="28" Margin="0,0,4,4" Cursor="SizeNWSE" IsHitTestVisible="True" DragStarted="OnResizeStarted" DragDelta="OnResize" DragCompleted="OnResizeCompleted"/>
            </Grid>
        </Grid>
    </Border>

    <UserControl.ContextMenu>
        <!-- ContextMenu 不在视觉树中,需显式绑定到 PlacementTarget(本控件)的 DataContext。
             Header 用 DynamicResource,语言切换时自动刷新。 -->
        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="{DynamicResource menu.view}">
                <MenuItem Header="{DynamicResource view.large}" Click="OnViewLarge" IsCheckable="True"
                          IsChecked="{Binding ViewMode, Converter={StaticResource ModeEqual}, ConverterParameter={x:Static m:ViewMode.Large}, Mode=OneWay}"/>
                <MenuItem Header="{DynamicResource view.medium}" Click="OnViewMedium" IsCheckable="True"
                          IsChecked="{Binding ViewMode, Converter={StaticResource ModeEqual}, ConverterParameter={x:Static m:ViewMode.Medium}, Mode=OneWay}"/>
                <MenuItem Header="{DynamicResource view.small}" Click="OnViewSmall" IsCheckable="True"
                          IsChecked="{Binding ViewMode, Converter={StaticResource ModeEqual}, ConverterParameter={x:Static m:ViewMode.Small}, Mode=OneWay}"/>
                <MenuItem Header="{DynamicResource view.list}" Click="OnViewList" IsCheckable="True"
                          IsChecked="{Binding ViewMode, Converter={StaticResource ModeEqual}, ConverterParameter={x:Static m:ViewMode.List}, Mode=OneWay}"/>
                <MenuItem Header="{DynamicResource view.detail}" Click="OnViewDetail" IsCheckable="True"
                          IsChecked="{Binding ViewMode, Converter={StaticResource ModeEqual}, ConverterParameter={x:Static m:ViewMode.Detail}, Mode=OneWay}"/>
                <MenuItem Header="{DynamicResource view.tile}" Click="OnViewTile" IsCheckable="True"
                          IsChecked="{Binding ViewMode, Converter={StaticResource ModeEqual}, ConverterParameter={x:Static m:ViewMode.Tile}, Mode=OneWay}"/>
            </MenuItem>
            <!-- 显示时间:按盒子开启标题栏时钟(默认关闭,避免所有盒子都显示时间) -->
            <MenuItem Header="{DynamicResource box.menu.showClock}" Click="OnToggleShowClock"
                      IsCheckable="True" IsChecked="{Binding ShowClock, Mode=OneWay}"/>
            <!-- 一键整理桌面:与托盘/桌面右键同一入口,扫桌面新文件并归类进整理盒子 -->
            <MenuItem Header="{DynamicResource menu.organize}" Click="OnOrganizeDesktop"/>
            <!-- 卷起/展开:卷起后鼠标悬停会自动展开、移开自动收起(可在设置里关闭)。
                 两个菜单项按当前状态二选一显示,动词与即将发生的动作一致。 -->
            <MenuItem Header="{DynamicResource box.menu.rollUp}" Click="OnToggleCollapse">
                <MenuItem.Style>
                    <Style TargetType="MenuItem">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCollapsed}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </MenuItem.Style>
            </MenuItem>
            <MenuItem Header="{DynamicResource box.menu.expandBox}" Click="OnToggleCollapse">
                <MenuItem.Style>
                    <Style TargetType="MenuItem">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCollapsed}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </MenuItem.Style>
            </MenuItem>
            <!-- 锁定位置:锁定后不能拖动/缩放,避免误移动 -->
            <MenuItem Header="{DynamicResource box.menu.lock}" Click="OnToggleLock">
                <MenuItem.Style>
                    <Style TargetType="MenuItem">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </MenuItem.Style>
            </MenuItem>
            <MenuItem Header="{DynamicResource box.menu.unlock}" Click="OnToggleLock">
                <MenuItem.Style>
                    <Style TargetType="MenuItem">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </MenuItem.Style>
            </MenuItem>
            <Separator/>
            <MenuItem Header="{DynamicResource box.menu.rename}" Click="OnRename"/>
            <MenuItem Header="{DynamicResource box.menu.removeSelected}" Click="OnRemoveSelected"/>
            <MenuItem Header="{DynamicResource box.menu.refreshItems}" Click="OnRefreshItems"/>
            <MenuItem Header="{DynamicResource box.menu.clear}" Click="OnClear" Tag="structural"/>
            <Separator/>
            <!-- 仅标签模式 -->
            <MenuItem Header="{DynamicResource box.menu.newTab}" Click="OnAddTab">
                <MenuItem.Style>
                    <Style TargetType="MenuItem">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsTabbed}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </MenuItem.Style>
            </MenuItem>
            <MenuItem Header="{DynamicResource box.menu.renameTab}" Click="OnRenameTab">
                <MenuItem.Style>
                    <Style TargetType="MenuItem">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsTabbed}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </MenuItem.Style>
            </MenuItem>
            <MenuItem Header="{DynamicResource box.menu.deleteTab}" Click="OnDeleteTab">
                <MenuItem.Style>
                    <Style TargetType="MenuItem">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsTabbed}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </MenuItem.Style>
            </MenuItem>
            <!-- 仅普通模式 -->
            <MenuItem Header="{DynamicResource box.menu.toTabbed}" Click="OnConvertToTabbed">
                <MenuItem.Style>
                    <Style TargetType="MenuItem">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsTabbed}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </MenuItem.Style>
            </MenuItem>
            <!-- 仅标签模式 -->
            <MenuItem Header="{DynamicResource box.menu.mergeIn}" Click="OnMergeIn" Tag="structural">
                <MenuItem.Style>
                    <Style TargetType="MenuItem">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsTabbed}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </MenuItem.Style>
            </MenuItem>
            <MenuItem Header="{DynamicResource box.menu.split}" Click="OnSplit" Tag="structural">
                <MenuItem.Style>
                    <Style TargetType="MenuItem">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsTabbed}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </MenuItem.Style>
            </MenuItem>
            <Separator/>
            <MenuItem Header="{DynamicResource box.menu.delete}" Click="OnDelete" Tag="structural"/>
        </ContextMenu>
    </UserControl.ContextMenu>
</UserControl>
