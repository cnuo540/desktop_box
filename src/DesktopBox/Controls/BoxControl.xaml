<UserControl x:Class="DesktopBox.Controls.BoxControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:DesktopBox.Controls"
             xmlns:m="clr-namespace:DesktopBox.Models"
             AllowDrop="True"
             Drop="OnDrop"
             DragOver="OnDragOver"
             LostMouseCapture="OnLostMouseCapture"
             MouseEnter="OnBoxMouseEnter"
             MouseLeave="OnBoxMouseLeave"
             ContextMenuOpening="OnContextMenuOpening">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
        <ctl:EnumEqualityToBoolConverter x:Key="ModeEqual"/>
        <ctl:BoolToEyeStrokeConverter x:Key="BoolToEyeBrush"/>
        <ctl:BoolToEyeFillConverter x:Key="BoolToEyeFill"/>
    </UserControl.Resources>
    <Border x:Name="Card"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            CornerRadius="10"
            Background="#99000000"
            ClipToBounds="True">
        <!-- 杈规璧?Style:鎷栧姩涓殑鐩掑瓙鎮仠鍦ㄦ湰鐩掑瓙涓?IsMergeTarget)鏃惰楂樹寒鎴?鍚堝苟鐩爣" -->
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="BorderBrush" Value="#66FFFFFF"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsMergeTarget}" Value="True">
                        <Setter Property="BorderBrush" Value="#FF4FC3F7"/>
                        <Setter Property="BorderThickness" Value="2"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 鏍囬鏍?榧犳爣鎸変笅鍙嫋鍔ㄦ暣涓洅瀛?鍙屽嚮=鍗疯捣/灞曞紑 -->
            <Border Grid.Row="0"
                    x:Name="HeaderBar"
                    Background="#66000000"
                    Padding="12,8"
                    MouseLeftButtonDown="OnHeaderDown"
                    MouseMove="OnHeaderMove"
                    MouseLeftButtonUp="OnHeaderUp">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>   <!-- 0 鏃堕棿(骞虫椂鏄剧ず,榧犳爣杩涚洅瀛愭椂闅愯棌) -->
                        <ColumnDefinition Width="*"/>      <!-- 1 鍚嶇О(灞呬腑) -->
                        <ColumnDefinition Width="Auto"/>   <!-- 2 鑹叉爣 + 鎿嶄綔鎸夐挳 -->
                    </Grid.ColumnDefinitions>

                    <!-- 鏍囬鏍忔椂閽?骞虫椂鏄剧ず褰撳墠鏃堕棿(HH:mm,姣忓垎閽熷埛鏂?,榧犳爣绉诲埌鐩掑瓙涓?灞曞紑鍖哄煙)鏃堕殣钘?
                         鎶婃爣棰樻爮璁╃粰鍚嶇О涓庡彸渚ф搷浣滄寜閽€傜敤 Hidden 鑰屼笉鏄?Collapsed:淇濈暀鍗犱綅,鎮仠鏃跺竷灞€涓嶈烦鍔ㄣ€?-->
                    <TextBlock Grid.Column="0"
                               x:Name="HeaderClock"
                               Text="{Binding Source={x:Static ctl:HeaderClock.Instance}, Path=CurrentTime}"
                               Margin="0,0,10,0"
                               FontSize="16"
                               Foreground="#B3FFFFFF"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                        <Setter Property="Visibility" Value="Hidden"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Grid.Column="1"
                               Text="{Binding Header}"
                               FontWeight="SemiBold"
                               FontSize="13"
                               Foreground="White"
                               VerticalAlignment="Center"
                               TextAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>

                    <!-- 鍙充晶:涓変釜鎿嶄綔鎸夐挳(閿?/ 鍗疯捣 / 鐪肩潧)銆?                         鎸夐挳骞虫椂闅愯棌,榧犳爣绉诲埌鐩掑瓙涓?灞曞紑鍖哄煙)鎵嶆樉绀衡€斺€斿钩鏃舵爣棰樻爮鍙暀鏃堕棿涓庡悕绉般€?                         闅愯棌鐢?Hidden 淇濈暀鍗犱綅,鍚嶇О鐨勪綅缃笉浼氬洜鎮仠鑰岃烦鍔ㄣ€?-->
                    <StackPanel Grid.Column="2"
                                x:Name="HeaderActions"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="4,0,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Hidden"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <!-- 閿佸畾浣嶇疆:閿佸畾鍚庝笉鑳芥嫋鍔?缂╂斁(钃濊壊闂悎閿?宸查攣瀹?鐏拌壊寮€鍙ｉ攣=鏈攣瀹?銆?                             閿佸畾鐨勭洅瀛愪粛鍙嵎璧?鎮仠灞曞紑鈥斺€斿畠浠笉鏀瑰彉鐩掑瓙浣嶇疆銆?-->
                        <Button x:Name="LockBtn"
                                Click="OnToggleLock"
                                ToolTip="{Binding LockActionText}"
                                Width="24" Height="24" Padding="0"
                                Background="Transparent"
                                BorderBrush="#66FFFFFF"
                                Cursor="Hand">
                            <Path Width="16" Height="16" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Data" Value="M9,9 V6.5 A2.5,2.5 0 0 1 14,6.5 M5,9 H14 V17 H5 Z"/>
                                        <Setter Property="Stroke" Value="#FF777777"/>
                                        <Setter Property="StrokeThickness" Value="1.4"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                                <Setter Property="Data" Value="M7,9 V6.5 A2.5,2.5 0 0 1 12,6.5 V9 M5,9 H14 V17 H5 Z"/>
                                                <Setter Property="Stroke" Value="#FF4FC3F7"/>
                                                <Setter Property="StrokeThickness" Value="1.8"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Button>
                        <!-- 鍥炬爣澶у皬:澶у浘鏍?鈫?涓浘鏍?鈫?灏忓浘鏍?寰幆(鍏ㄥ眬鐢熸晥,鎵€鏈夌洅瀛愪竴鑷?銆?                             鍥炬爣鏈韩鍙嶆槧褰撳墠妗ｄ綅:1 涓ぇ鏂瑰潡 / 4 涓腑鏂瑰潡 / 9 涓皬鏂瑰潡銆?-->
                        <Button x:Name="IconSizeBtn"
                                Click="OnCycleIconSize"
                                ToolTip="{Binding IconSizeActionText}"
                                Width="24" Height="24" Margin="4,0,0,0" Padding="0"
                                Background="Transparent"
                                BorderBrush="#66FFFFFF"
                                Cursor="Hand">
                            <Path Width="15" Height="15" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Fill="#FFDDDDDD">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Data" Value="M2,2 H14 V14 H2 Z"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ViewMode}" Value="{x:Static m:ViewMode.Medium}">
                                                <Setter Property="Data" Value="M1,1 H7 V7 H1 Z M9,1 H15 V7 H9 Z M1,9 H7 V15 H1 Z M9,9 H15 V15 H9 Z"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ViewMode}" Value="{x:Static m:ViewMode.Small}">
                                                <Setter Property="Data" Value="M1,1 H5 V5 H1 Z M6,1 H10 V5 H6 Z M11,1 H15 V5 H11 Z M1,6 H5 V10 H1 Z M6,6 H10 V10 H6 Z M11,6 H15 V10 H11 Z M1,11 H5 V15 H1 Z M6,11 H10 V15 H6 Z M11,11 H15 V15 H11 Z"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Button>
                        <!-- 鍗疯捣/灞曞紑鎸夐挳:灞曞紑鏃舵樉绀哄悜涓婄澶?鐐逛簡灏卞嵎璧?,鍗疯捣鏃舵樉绀哄悜涓嬬澶淬€?                             鍗疯捣鍚庨紶鏍囨偓鍋滀細鑷姩灞曞紑(鍙湪璁剧疆閲屽叧鎺?銆?-->
                        <Button x:Name="CollapseBtn"
                                Click="OnToggleCollapse"
                                ToolTip="{Binding CollapseActionText}"
                                Width="24" Height="24" Margin="4,0,0,0" Padding="0"
                                Background="Transparent"
                                BorderBrush="#66FFFFFF"
                                Cursor="Hand">
                            <Path Width="12" Height="7" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Stroke="White" StrokeThickness="1.8">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Data" Value="M1,7 L6,1 L11,7"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCollapsed}" Value="True">
                                                <Setter Property="Data" Value="M1,1 L6,7 L11,1"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Button>
                        <!-- 鏄剧ず/闅愯棌妗岄潰鍥炬爣蹇嵎鎸夐挳:鐪肩潧鍥炬爣,鏄剧ず=浜壊瀹炲績,闅愯棌=鏆楄壊绌哄績 -->
                        <Button x:Name="ToggleIconsBtn"
                                Click="OnToggleDesktopIcons"
                                ToolTip="{DynamicResource tip.toggleIcons}"
                                Width="24" Height="24" Margin="4,0,0,0" Padding="0"
                                Background="Transparent"
                                BorderBrush="#66FFFFFF"
                                Cursor="Hand"
                                Tag="{Binding MainVm.DesktopIconsVisible, RelativeSource={RelativeSource AncestorType=UserControl}}">
                            <Path Width="16" Height="16" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  StrokeThickness="1.6"
                                  Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Tag, Converter={StaticResource BoolToEyeBrush}}"
                                  Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Tag, Converter={StaticResource BoolToEyeFill}}"
                                  Data="M12,5C5,5 1,12 1,12C1,12 5,19 12,19C19,19 23,12 23,12C23,12 19,5 12,5 Z M12,9A3,3 0 1,0 12,15A3,3 0 1,0 12,9 Z"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 鏍囩琛?浠呮爣绛炬ā寮忎笖闈炲嵎璧锋椂鍙) -->
            <Grid Grid.Row="1"
                  x:Name="TabRow"
                  Visibility="{Binding ShowTabs, Converter={StaticResource BoolVis}}"
                  Background="#33000000">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>     <!-- 宸﹀脊鎬?鎶婃爣绛剧粍椤跺埌涓棿 -->
                    <ColumnDefinition Width="Auto"/>  <!-- 鏍囩缁?鍚堝苟鐩掑瓙鐨勫涓悕瀛? -->
                    <ColumnDefinition Width="*"/>     <!-- 鍙冲脊鎬?-->
                </Grid.ColumnDefinitions>
                <!-- 鏍囩缁勫眳涓?涓や晶鍚勪竴涓脊鎬у垪銆侻axWidth 鍏滃簳鈥斺€旀爣绛惧鍒拌秴杩囩洅瀛愬搴︽椂
                     浠嶇敱 ListBox 鍐呴儴妯悜婊氬姩(婊氳疆鍙崲鏍囩),涓嶄細椤剁┛鐩掑瓙銆?-->
                <ListBox x:Name="TabList" Grid.Column="1"
                         MaxWidth="{Binding ActualWidth, ElementName=TabRow}"
                         Margin="0,0,34,0"
                         ItemsSource="{Binding Tabs}"
                         SelectedItem="{Binding SelectedTab, Mode=TwoWay}"
                         Background="Transparent"
                         BorderThickness="0"
                         Focusable="False"
                         AllowDrop="True"
                         PreviewMouseLeftButtonDown="OnTabListMouseDown"
                         PreviewMouseMove="OnTabListMouseMove"
                         PreviewMouseRightButtonDown="OnTabListPreviewMouseRightButtonDown"
                         PreviewMouseWheel="OnTabListPreviewMouseWheel"
                         DragOver="OnTabListDragOver"
                         Drop="OnTabListDrop"
                         ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="10,4"/>
                            <Setter Property="Margin" Value="2,3"/>
                            <Setter Property="Foreground" Value="#FFCCCCCC"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <!-- 榧犳爣绉诲埌鏍囩鍚嶄笂鍗冲垏鎹?绛変环浜庣偣涓€涓?,涓嶅繀鍏堢偣鍐嶇瓑 -->
                            <EventSetter Event="MouseEnter" Handler="OnTabItemMouseEnter"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Grid>
                                            <!-- 閫変腑鑳屾櫙 (Selected) -->
                                            <Border x:Name="SelectedBd"
                                                    CornerRadius="6"
                                                    Background="#665599FF"
                                                    BorderBrush="#995599FF"
                                                    BorderThickness="1"
                                                    Opacity="0"
                                                    IsHitTestVisible="False"/>
                                            <!-- 鎮仠鑳屾櫙 (Hover) -->
                                            <Border x:Name="HoverBd"
                                                    CornerRadius="6"
                                                    Background="#26FFFFFF"
                                                    BorderBrush="#33FFFFFF"
                                                    BorderThickness="1"
                                                    Opacity="0"
                                                    IsHitTestVisible="False"/>
                                            <!-- 鍐呭鍛堢幇 -->
                                            <Border x:Name="ContentBd"
                                                    CornerRadius="6"
                                                    Padding="{TemplateBinding Padding}"
                                                    Background="Transparent">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="HoverBd" Property="Opacity" Value="1"/>
                                                <Trigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="HoverBd"
                                                                             Storyboard.TargetProperty="Opacity"
                                                                             To="1.0" Duration="0:0:0.15"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.EnterActions>
                                                <Trigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="HoverBd"
                                                                             Storyboard.TargetProperty="Opacity"
                                                                             To="0.0" Duration="0:0:0.15"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.ExitActions>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="SelectedBd" Property="Opacity" Value="1"/>
                                                <Setter Property="Foreground" Value="White"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Trigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="SelectedBd"
                                                                             Storyboard.TargetProperty="Opacity"
                                                                             To="1.0" Duration="0:0:0.15"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.EnterActions>
                                                <Trigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="SelectedBd"
                                                                             Storyboard.TargetProperty="Opacity"
                                                                             To="0.0" Duration="0:0:0.15"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.ExitActions>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Header}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Button Grid.Column="2" Content="+"
                        HorizontalAlignment="Right"
                        Width="24" Height="22" Margin="2,3,8,3"
                        FontSize="16" Padding="0"
                        Click="OnAddTab" ToolTip="{DynamicResource tip.newTab}"/>
            </Grid>

            <!-- 鏉＄洰鍒楄〃(褰撳墠鏍囩 / Items):鎸?ViewMode 鍒囨崲甯冨眬銆傚嵎璧锋椂鏁村潡闅愯棌,鍙暀鏍囬鏍?-->
            <ScrollViewer x:Name="ItemsScroll"
                          Grid.Row="2"
                          Visibility="{Binding ShowContent, Converter={StaticResource BoolVis}}"
                          VerticalScrollBarVisibility="Visible"
                          HorizontalScrollBarVisibility="Disabled"
                          Background="Transparent"
                          PreviewMouseLeftButtonDown="OnItemsAreaMouseDown"
                          Padding="4">
                <Grid x:Name="ItemsViewport"
                      Width="{Binding ElementName=ItemsScroll, Path=ViewportWidth}"
                      Background="Transparent">
                    <!-- 澶у浘鏍?榛樿(澶ф柟鍧? -->
                    <ItemsControl ItemsSource="{Binding DisplayItems}"
                                  Visibility="{Binding IsLarge, Converter={StaticResource BoolVis}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel ItemWidth="100" Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate><ctl:ItemTile IconSize="Large"/></DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 涓瓑鍥炬爣 -->
                    <ItemsControl ItemsSource="{Binding DisplayItems}"
                                  Visibility="{Binding IsMedium, Converter={StaticResource BoolVis}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel ItemWidth="84" Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate><ctl:ItemTile IconSize="Medium"/></DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 灏忓浘鏍?妯悜娴佸紡,16px 鍥炬爣 + 鍚嶇О) -->
                    <ItemsControl ItemsSource="{Binding DisplayItems}"
                                  Visibility="{Binding IsSmall, Converter={StaticResource BoolVis}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate><ctl:ItemTile IconSize="Small"/></DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 鍒楄〃(绾靛悜鍗曞垪) -->
                    <ItemsControl ItemsSource="{Binding DisplayItems}"
                                  Visibility="{Binding IsList, Converter={StaticResource BoolVis}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Vertical"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate><ctl:ItemTile IconSize="Small"/></DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 璇︾粏淇℃伅:鍚嶇О/淇敼鏃堕棿/澶у皬 -->
                    <ItemsControl ItemsSource="{Binding DisplayItems}"
                                  Visibility="{Binding IsDetail, Converter={StaticResource BoolVis}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Vertical"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate><ctl:ItemTile IconSize="Detail"/></DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 骞抽摵(鍥炬爣+鍚嶇О,妯悜鍗＄墖) -->
                    <ItemsControl ItemsSource="{Binding DisplayItems}"
                                  Visibility="{Binding IsTile, Converter={StaticResource BoolVis}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate><ctl:ItemTile IconSize="Tile"/></DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </ScrollViewer>

            <!-- 鍏柟鍚戠缉鏀炬墜鏌?瑕嗙洊鍗＄墖杈圭紭銆備腑闂撮€忔槑鍖哄煙 hit-test 绌块€忓埌涓嬪眰,涓嶅奖鍝嶄氦浜掋€?                 鍗疯捣鏃?娌℃湁鍐呭鍖哄彲缂╂斁)鎴栭攣瀹氫綅缃椂涓嶆樉绀恒€?-->
            <Grid Grid.Row="0" Grid.RowSpan="3" Margin="0"
                  Visibility="{Binding ShowResizeHandles, Converter={StaticResource BoolVis}}">
                <Grid.Resources>
                    <Style TargetType="Thumb">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Thumb">
                                    <Rectangle Fill="Transparent"/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Grid.Resources>
                <Border HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Width="18"
                        Height="18"
                        Margin="0,0,5,5"
                        IsHitTestVisible="False"
                        Opacity="0.55">
                    <Canvas>
                        <Line X1="14" Y1="4" X2="4" Y2="14" Stroke="#CCFFFFFF" StrokeThickness="1"/>
                        <Line X1="14" Y1="9" X2="9" Y2="14" Stroke="#CCFFFFFF" StrokeThickness="1"/>
                    </Canvas>
                </Border>
                <Thumb Tag="N"  HorizontalAlignment="Stretch" VerticalAlignment="Top"    Height="10" Margin="0,0,44,0" Cursor="SizeNS"   IsHitTestVisible="True" DragStarted="OnResizeStarted" DragDelta="OnResize" DragCompleted="OnResizeCompleted"/>
                <Thumb Tag="S"  HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Height="18" Margin="12,0,12,4" Cursor="SizeNS"   IsHitTestVisible="True" DragStarted="OnResizeStarted" DragDelta="OnResize" DragCompleted="OnResizeCompleted"/>
